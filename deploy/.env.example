# ── Required ──────────────────────────────────────────────────
# DeepSeek API key for the LLM backend
DEEPSEEK_API_KEY=your_api_key_here

# ── Optional ──────────────────────────────────────────────────
# Custom LLM provider (default: deepseek)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# MCP / Parallel Search API key
# PARALLEL_API_KEY=...